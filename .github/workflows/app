<meta charset="utf-8" />
<title>Silver Support</title>
<meta name="description" content="Patient, friendly in-person and remote tech support for seniors and anyone who wants a hand. Serving Saint Augustine, Florida." />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Libre+Franklin:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />

<style>
  :root {
    /* ---- Light palette (also the base for the un-stamped/system state) ---- */
    --paper:      #F6F4EF;
    --surface:    #FFFFFF;
    --surface-2:  #F0EDE5;
    --ink:        #1E2A30;
    --ink-soft:   #47585F;
    --silver:     #85929A;
    --line:       #E4DFD5;
    --teal:       #0E6E7C;
    --teal-deep:  #0A5560;
    --teal-tint:  #E4EFF0;
    --amber:      #A85A26;
    --amber-deep: #8F4B1E;
    --clay:       #9E382D;
    --clay-tint:  #F4E5E0;
    --on-teal:    #F3FBFB;
    --on-clay:    #FBEDE9;
    --focus:      #0E6E7C;
    --shadow:     0 1px 2px rgba(30,42,48,.06), 0 10px 30px -18px rgba(30,42,48,.28);

    --font-display: "Fraunces", Georgia, "Times New Roman", serif;
    --font-body: "Libre Franklin", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    --container: 1140px;
    --pad-inline: clamp(1.25rem, 5vw, 2.5rem);
    --section-y: clamp(3.5rem, 8vw, 6rem);
    --radius: 14px;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper:      #121B1C;
      --surface:    #192325;
      --surface-2:  #1F2B2D;
      --ink:        #ECE9E1;
      --ink-soft:   #B2BEC0;
      --silver:     #7C8A8E;
      --line:       #2C3A3C;
      --teal:       #49B8C5;
      --teal-deep:  #6FCED8;
      --teal-tint:  #143130;
      --amber:      #D68C4F;
      --amber-deep: #E4A06A;
      --clay:       #C6584A;
      --clay-tint:  #38201C;
      --on-teal:    #06201F;
      --on-clay:    #FBEDE9;
      --focus:      #6FCED8;
      --shadow:     0 1px 2px rgba(0,0,0,.3), 0 14px 40px -20px rgba(0,0,0,.6);
    }
  }

  :root[data-theme="dark"] {
    --paper:      #121B1C;
    --surface:    #192325;
    --surface-2:  #1F2B2D;
    --ink:        #ECE9E1;
    --ink-soft:   #B2BEC0;
    --silver:     #7C8A8E;
    --line:       #2C3A3C;
    --teal:       #49B8C5;
    --teal-deep:  #6FCED8;
    --teal-tint:  #143130;
    --amber:      #D68C4F;
    --amber-deep: #E4A06A;
    --clay:       #C6584A;
    --clay-tint:  #38201C;
    --on-teal:    #06201F;
    --on-clay:    #FBEDE9;
    --focus:      #6FCED8;
    --shadow:     0 1px 2px rgba(0,0,0,.3), 0 14px 40px -20px rgba(0,0,0,.6);
  }

  *, *::before, *::after { box-sizing: border-box; }

  [hidden] { display: none !important; }

  html {
    font-size: 112.5%; /* 18px base */
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.012em;
    text-wrap: balance;
    margin: 0;
  }

  p { margin: 0; }
  img, svg { max-width: 100%; }

  a {
    color: var(--teal);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  a:hover { color: var(--teal-deep); }

  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .container {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--pad-inline);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100px;
    background: var(--surface);
    color: var(--ink);
    padding: .75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    z-index: 200;
    transition: top .15s ease;
  }
  .skip-link:focus { top: 1rem; }

  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .site-header.scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px -20px rgba(30,42,48,.5);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 74px;
    position: relative;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand:hover { color: var(--ink); }
  .brand-mark {
    width: 36px; height: 36px;
    flex: none;
    display: block;
  }
  .brand-mark svg { width: 100%; height: 100%; display: block; }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }
  .site-nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: .94rem;
    font-weight: 500;
    padding: .35rem 0;
    white-space: nowrap;
  }
  .site-nav a:hover { color: var(--teal); }

  .header-actions { display: flex; align-items: center; gap: .75rem; }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: .5rem;
    background: transparent;
    border: 1.5px solid var(--line);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: .95rem;
    font-weight: 600;
    padding: .6rem .85rem;
    border-radius: 10px;
    cursor: pointer;
    min-height: 46px;
  }
  .nav-toggle svg { width: 20px; height: 20px; }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 52px;
    padding: .85rem 1.35rem;
    border-radius: 11px;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: transform .12s ease, background .18s ease, border-color .18s ease, color .18s ease;
  }
  .btn:active { transform: translateY(1px); }
  .btn svg { width: 19px; height: 19px; flex: none; }

  .btn-primary { background: var(--amber); color: #fff; }
  .btn-primary:hover { background: var(--amber-deep); color: #fff; }

  .btn-outline { background: transparent; border-color: var(--teal); color: var(--teal); }
  .btn-outline:hover { background: var(--teal-tint); color: var(--teal-deep); }

  .btn-ghost { background: var(--surface); border-color: var(--line); color: var(--ink); }
  .btn-ghost:hover { border-color: var(--teal); color: var(--teal); }

  .btn-on-dark { background: #fff; color: var(--clay); }
  .btn-on-dark:hover { background: #fff; color: var(--clay); opacity: .92; }

  .btn-on-teal { background: var(--surface); color: var(--teal); border-color: transparent; }
  .btn-on-teal:hover { opacity: .92; }
  .btn-outline-on-teal { background: transparent; border-color: color-mix(in srgb, var(--on-teal) 55%, transparent); color: var(--on-teal); }
  .btn-outline-on-teal:hover { background: color-mix(in srgb, var(--on-teal) 12%, transparent); color: var(--on-teal); }

  .btn-lg { min-height: 58px; padding: 1rem 1.7rem; font-size: 1.05rem; }

  /* ---------- Generic section ---------- */
  .section { padding-block: var(--section-y); }
  .section--tint { background: var(--surface-2); }
  .section-head { max-width: 60ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal);
    margin: 0 0 .9rem;
  }
  .section h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); }
  .section-head p {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  [id] { scroll-margin-top: 92px; }

  /* ---------- Hero ---------- */
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 6rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    font-family: var(--font-mono);
    font-size: .8rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--teal);
    border: 1px solid var(--line);
    background: var(--surface);
    padding: .4rem .8rem;
    border-radius: 999px;
  }
  .hero-eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); flex: none; }
  .hero h1 {
    font-size: clamp(2.35rem, 6vw, 3.55rem);
    margin: 1.4rem 0 0;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--teal);
  }
  .hero-lead {
    margin-top: 1.35rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .hero-cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: .9rem;
  }
  .hero-trust {
    margin-top: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.4rem;
    font-size: .92rem;
    color: var(--ink-soft);
    list-style: none;
    padding: 0;
  }
  .hero-trust li { display: flex; align-items: center; gap: .5rem; }
  .hero-trust svg { width: 18px; height: 18px; color: var(--teal); flex: none; }

  .hero-visual { display: flex; justify-content: center; }
  .hero-visual svg { width: 100%; max-width: 420px; height: auto; filter: drop-shadow(0 24px 44px rgba(30,42,48,.18)); }

  /* ---------- Trust strip ---------- */
  .strip {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
    padding-block: 2.25rem;
  }
  .strip-item { display: flex; gap: .8rem; align-items: flex-start; }
  .strip-item .ico {
    width: 40px; height: 40px; flex: none;
    display: grid; place-items: center;
    border-radius: 10px;
    background: var(--teal-tint);
    color: var(--teal);
  }
  .strip-item .ico svg { width: 21px; height: 21px; }
  .strip-item h3 { font-family: var(--font-body); font-size: 1rem; font-weight: 700; letter-spacing: 0; }
  .strip-item p { font-size: .9rem; color: var(--ink-soft); margin-top: .15rem; }

  /* ---------- Services ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem 1.5rem 1.7rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
  }
  .card .ico {
    width: 46px; height: 46px;
    display: grid; place-items: center;
    border-radius: 12px;
    background: var(--teal-tint);
    color: var(--teal);
    margin-bottom: 1.1rem;
  }
  .card .ico svg { width: 24px; height: 24px; }
  .card h3 { font-size: 1.24rem; }
  .card p { margin-top: .55rem; color: var(--ink-soft); font-size: .98rem; }
  .card ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .4rem;
    font-size: .9rem;
    color: var(--ink-soft);
  }
  .card li { display: flex; gap: .5rem; align-items: flex-start; }
  .card li::before {
    content: "";
    width: 6px; height: 6px;
    margin-top: .55rem;
    border-radius: 50%;
    background: var(--amber);
    flex: none;
  }

  /* ---------- Scam band ---------- */
  .band-scam {
    background: var(--clay);
    color: var(--on-clay);
  }
  .band-scam .eyebrow { color: color-mix(in srgb, var(--on-clay) 78%, transparent); }
  .scam-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  .band-scam h2 { font-size: clamp(1.9rem, 4vw, 2.6rem); }
  .band-scam .lead { margin-top: 1rem; font-size: 1.08rem; color: color-mix(in srgb, var(--on-clay) 88%, transparent); }
  .scam-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: .9rem;
  }
  .scam-list li {
    display: flex;
    gap: .7rem;
    align-items: flex-start;
    background: color-mix(in srgb, #000 12%, var(--clay));
    border: 1px solid color-mix(in srgb, var(--on-clay) 18%, transparent);
    border-radius: 10px;
    padding: .8rem .95rem;
    font-size: .96rem;
  }
  .scam-list svg { width: 20px; height: 20px; flex: none; margin-top: 2px; color: var(--on-clay); }
  .scam-cta { margin-top: 1.75rem; }

  /* ---------- How it works ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .step {
    position: relative;
    padding: 1.6rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .step .num {
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 500;
    color: var(--teal);
    letter-spacing: .1em;
  }
  .step h3 { font-size: 1.2rem; margin-top: .5rem; }
  .step p { margin-top: .5rem; color: var(--ink-soft); font-size: .96rem; }

  /* ---------- Booking ---------- */
  .booking-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }
  .booking-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.2rem, 3vw, 1.6rem);
    box-shadow: var(--shadow);
  }

  .cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: .75rem;
  }
  .cal-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .cal-nav {
    width: 44px; height: 44px;
    flex: none;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .cal-nav:hover:not(:disabled) { border-color: var(--teal); color: var(--teal); }
  .cal-nav:disabled { opacity: .3; cursor: not-allowed; }

  .cal-dow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
    margin-bottom: 6px;
  }
  .cal-dow span {
    text-align: center;
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--silver);
  }
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
  }
  .cal-day {
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1.5px solid transparent;
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .cal-day:hover:not(:disabled) { border-color: var(--teal); color: var(--teal); }
  .cal-day:disabled { color: var(--silver); background: transparent; cursor: default; opacity: .45; }
  .cal-day.is-empty { visibility: hidden; }
  .cal-day[aria-pressed="true"] {
    background: var(--teal);
    color: var(--on-teal);
    border-color: var(--teal);
  }
  .cal-note { margin-top: 1rem; font-size: .85rem; color: var(--silver); }

  .booking-panel { min-height: 360px; display: flex; flex-direction: column; }
  .booking-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    color: var(--ink-soft);
    padding: 1.5rem;
  }
  .booking-empty svg { width: 44px; height: 44px; color: var(--teal); }

  .slot-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .85rem 1rem;
    background: var(--teal-tint);
    border-radius: 10px;
    margin-bottom: 1.3rem;
  }
  .slot-summary .when { font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .slot-summary button {
    background: none;
    border: 0;
    color: var(--teal-deep);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: .9rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    flex: none;
  }

  .booking-step-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: .9rem;
  }
  .slot-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .6rem;
  }
  .slot {
    min-height: 50px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: .95rem;
    cursor: pointer;
  }
  .slot:hover { border-color: var(--teal); color: var(--teal); }
  .slot[aria-pressed="true"] { background: var(--teal); color: var(--on-teal); border-color: var(--teal); }

  .booking-done {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    padding: 1.5rem;
  }
  .booking-done .check {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--teal-tint);
    color: var(--teal);
    display: grid;
    place-items: center;
  }
  .booking-done .check svg { width: 28px; height: 28px; }
  .booking-done h3 { font-size: 1.3rem; }
  .booking-done p { color: var(--ink-soft); max-width: 34ch; }

  /* ---------- Pricing ---------- */
  .price-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }
  .price {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.8rem 1.6rem;
    box-shadow: var(--shadow);
  }
  .price.is-feature {
    border-color: var(--teal);
    border-width: 2px;
  }
  .price .tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--on-teal);
    background: var(--teal);
    padding: .3rem .6rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .price h3 { font-size: 1.3rem; }
  .price .amount {
    margin-top: .7rem;
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
  }
  .price .amount span {
    font-family: var(--font-body);
    font-size: .95rem;
    font-weight: 500;
    color: var(--silver);
  }
