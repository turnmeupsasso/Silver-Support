      cform.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!cform.checkValidity()) { cform.reportValidity(); return; }
        var d = new FormData(cform);
        var body = [
          'Name: ' + (d.get('name') || ''),
          'Phone: ' + (d.get('phone') || ''),
          'Email: ' + (d.get('email') || '(not given)'),
          '',
          (d.get('message') || '')
        ].join('\n');
        window.location.href = 'mailto:silversupporttt@gmail.com'
          + '?subject=' + encodeURIComponent('Question from ' + (d.get('name') || 'website visitor'))
          + '&body=' + encodeURIComponent(body);
      });
    }

    /* ================= Booking calendar ================= */
    var grid    = document.getElementById('calGrid');
    var title   = document.getElementById('calTitle');
    var prevBtn = document.getElementById('calPrev');
    var nextBtn = document.getElementById('calNext');

    var elEmpty = document.getElementById('bkEmpty');
    var elSlots = document.getElementById('bkSlots');
    var elForm  = document.getElementById('bkForm');
    var elDone  = document.getElementById('bkDone');
    var slotRow = document.getElementById('bkSlotRow');
    var slotsWhen = document.getElementById('bkSlotsWhen');
    var formWhen  = document.getElementById('bkFormWhen');
    var doneMsg   = document.getElementById('bkDoneMsg');

    var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    var DAYS   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    var SLOTS  = ['9:00 AM','10:30 AM','12:00 PM','1:30 PM','3:00 PM','4:30 PM'];

    var today = new Date(); today.setHours(0, 0, 0, 0);
    var minMonth = new Date(today.getFullYear(), today.getMonth(), 1);
    var maxMonth = new Date(today.getFullYear(), today.getMonth() + 4, 1);
    var view = new Date(minMonth);

    var selectedDate = null;
    var selectedTime = null;

    function sameMonth(a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth(); }

    function fmtLong(dt) {
      return DAYS[dt.getDay()] + ', ' + MONTHS[dt.getMonth()] + ' ' + dt.getDate() + ', ' + dt.getFullYear();
    }

    function show(el) {
      [elEmpty, elSlots, elForm, elDone].forEach(function (n) { n.hidden = (n !== el); });
    }

    function renderCal() {
      grid.innerHTML = '';
      title.textContent = MONTHS[view.getMonth()] + ' ' + view.getFullYear();
      prevBtn.disabled = sameMonth(view, minMonth);
      nextBtn.disabled = sameMonth(view, maxMonth);

      var firstDow = new Date(view.getFullYear(), view.getMonth(), 1).getDay();
      var daysInMonth = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();

      for (var i = 0; i < firstDow; i++) {
        var blank = document.createElement('div');
        blank.className = 'cal-day is-empty';
        grid.appendChild(blank);
      }

      for (var day = 1; day <= daysInMonth; day++) {
        var cellDate = new Date(view.getFullYear(), view.getMonth(), day);
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cal-day';
        btn.textContent = day;

        var isPast = cellDate < today;
        var isSunday = cellDate.getDay() === 0;
        var isFar = cellDate > new Date(maxMonth.getFullYear(), maxMonth.getMonth() + 1, 0);

        if (isPast || isSunday || isFar) {
          btn.disabled = true;
        } else {
          btn.setAttribute('aria-pressed', selectedDate && cellDate.getTime() === selectedDate.getTime() ? 'true' : 'false');
          btn.setAttribute('aria-label', fmtLong(cellDate));
          (function (dt) {
            btn.addEventListener('click', function () { pickDate(dt); });
          })(cellDate);
        }
        grid.appendChild(btn);
      }
    }

    function pickDate(dt) {
      selectedDate = dt;
      selectedTime = null;
      renderCal();
      slotsWhen.textContent = fmtLong(dt);
      slotRow.innerHTML = '';
      SLOTS.forEach(function (t) {
        var s = document.createElement('button');
        s.type = 'button';
        s.className = 'slot';
        s.textContent = t;
        s.setAttribute('aria-pressed', 'false');
        s.addEventListener('click', function () { pickTime(t); });
        slotRow.appendChild(s);
      });
      show(elSlots);
    }

    function pickTime(t) {
      selectedTime = t;
      formWhen.textContent = fmtLong(selectedDate) + '  ·  ' + t;
      show(elForm);
      var nameField = document.getElementById('bk-name');
      if (nameField) nameField.focus();
    }

    prevBtn.addEventListener('click', function () {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      renderCal();
    });
    nextBtn.addEventListener('click', function () {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      renderCal();
    });
    document.getElementById('bkBackToCal').addEventListener('click', function () { show(elEmpty); });
    document.getElementById('bkBackToSlots').addEventListener('click', function () { show(elSlots); });
    document.getElementById('bkReset').addEventListener('click', function () {
      selectedDate = null; selectedTime = null; elForm.reset(); renderCal(); show(elEmpty);
      document.getElementById('booking').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });

    elForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = document.getElementById('bk-name');
      var phone = document.getElementById('bk-phone');
      if (!name.value.trim() || !phone.value.trim()) { elForm.reportValidity(); return; }
      var d = new FormData(elForm);
      var whenStr = fmtLong(selectedDate) + ' at ' + selectedTime;
      var body = [
        'Requested appointment',
        'Date:  ' + fmtLong(selectedDate),
        'Time:  ' + selectedTime,
        'Where: ' + (d.get('mode') || ''),
        'Address: ' + (d.get('address') || '(not given)'),
        '',
        'Name:  ' + (d.get('name') || ''),
        'Phone: ' + (d.get('phone') || ''),
        'Email: ' + (d.get('email') || '(not given)'),
        '',
        'What they need help with:',
        (d.get('message') || '(not described)')
      ].join('\n');

      window.location.href = 'mailto:silversupporttt@gmail.com'
        + '?subject=' + encodeURIComponent('Booking request — ' + whenStr)
        + '&body=' + encodeURIComponent(body);

      doneMsg.textContent = 'Your email app should have opened with a request for '
        + whenStr + ' ready to send. Press send and we’ll confirm within one business day. '
        + 'If nothing opened, call (410) 701-0751.';
      show(elDone);
    });

    renderCal();
  })();
</script>
